# Simulation mode (true = detect + decode + log, but never send real transactions)
# PRIVATE_KEY is optional in simulation mode — a throwaway keypair is generated
SIMULATION_MODE=true
MIRROR_EXIT=true

# Helius RPC (get your key at https://helius.dev)
HELIUS_API_KEY=your_helius_api_key_here
RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Exit fallback for migrated tokens (Pump curve complete -> Jupiter swap)
ENABLE_MIGRATION_EXIT=true
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1/swap

# Your wallet private key (base58 encoded)
PRIVATE_KEY=your_base58_encoded_private_key_here

# Target wallet to copy trade from
TARGET_WALLET=target_wallet_public_key_here

# Trade configuration
BUY_AMOUNT_SOL=0.01          # SOL to spend per copy trade
SLIPPAGE_BPS=500              # 500 = 5% slippage
PRIORITY_FEE_MICROLAMPORTS=100000  # Priority fee in microlamports

# Risk management
STOP_LOSS_PCT=40              # Sell if price drops 40% from entry
TAKE_PROFIT_PCT=50            # Ignored when MIRROR_EXIT=true
EXIT_POLL_INTERVAL_MS=5000    # How often to check TP/SL (ms)

# Logging
LOG_LEVEL=info                # debug | info | warn | error
